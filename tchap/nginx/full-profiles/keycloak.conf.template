# optional

#keycloak
server {
    server_name ${SSO_FQDN};
    server_tokens off;

    include /etc/nginx/conf.d/include/ssl.conf;

    location / {
        proxy_pass http://host.docker.internal:8082;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For ${DOLLAR}remote_addr;
    }
}